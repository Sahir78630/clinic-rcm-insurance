# Copy to .env and fill in. Never commit the real .env file.

# Sign-in for reception and billing staff (HTTP basic auth). Required before exposing the server.
APP_USERNAME=reception
APP_PASSWORD=change-me

# Server
PORT=3000
HOST=127.0.0.1
DATABASE_FILE=data/rcm.sqlite
FACILITY_LICENSE=DHA-F-0000000

# Eligibility source: "mock" (clinic member records) or "http" (live API).
# Leave unset to use "http" when an API URL is configured, otherwise "mock".
ELIGIBILITY_PROVIDER=

# One integration partner or payer API for all payers
ELIGIBILITY_API_URL=
ELIGIBILITY_API_KEY=
ELIGIBILITY_AUTH_HEADER=Authorization
ELIGIBILITY_AUTH_SCHEME=Bearer
ELIGIBILITY_TIMEOUT_MS=15000

# Optional per-payer overrides, using the codes in config/payers.json
# PAYER_DAM_API_URL=
# PAYER_DAM_API_KEY=

# DHA eClaimLink (Dubai Health Post Office) web service
# "live" sends to eClaimLink, "mock" simulates it in the local database, "off" hides it.
# Leave unset to use "live" when login and password are set, otherwise "mock".
ECLAIMLINK_MODE=
ECLAIMLINK_LOGIN=
ECLAIMLINK_PASSWORD=
ECLAIMLINK_URL=https://dhpo.eclaimlink.ae/ValidateTransactions.asmx
ECLAIMLINK_NAMESPACE=https://www.shafafiya.org/v2/
ECLAIMLINK_TIMEOUT_MS=60000
